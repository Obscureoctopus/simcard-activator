    def send_at(self, cmd):
        if not self.ser: return self.log("❌ Not connected")
        threading.Thread(target=self._send_thread, args=(cmd,), daemon=True).start()

    def _send_thread(self, cmd):
        try:
            self.ser.write(f"{cmd}\r\n".encode())
            time.sleep(1.2)
            resp = self.ser.read(4096).decode(errors="ignore").strip()
            self.log(f"→ {cmd}\n← {resp}")
        except Exception as e:
            self.log(f"❌ {e}")

    def send_multi(self, cmds):
        for cmd in cmds:
            self.send_at(cmd)
            time.sleep(0.8)

    def full_activation(self):
        self.log("🚀 Running complete Swiss Army activation sequence...")
        threading.Thread(target=self._full_seq, daemon=True).start()

    def _full_seq(self):
        cmds = ["AT+CPIN?", "AT+CFUN=1", "AT+COPS=0", "AT+CSQ", "AT+CREG?", "AT+CPSI?"]
        for c in cmds: 
            self.send_at(c)
            time.sleep(2)
        self.log("🎉 SIM is fully armed and ready for ANY phone tray!")

